{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Focus Timer",
  "identifier": "com.rbika.focus-timer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Focus Timer",
        "width": 290,
        "height": 230,
        "resizable": false,
        "fullscreen": false,
        "visible": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "minimizable": false,
        "maximizable": false,
        "skipTaskbar": true,
        "center": false
      },
      {
        "label": "settings",
        "title": "Settings",
        "width": 560,
        "height": 520,
        "resizable": false,
        "fullscreen": false,
        "visible": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "minimizable": false,
        "maximizable": false,
        "skipTaskbar": true,
        "center": true
      },
      {
        "label": "up-to-date",
        "title": "Focus Timer",
        "width": 260,
        "height": 280,
        "resizable": false,
        "fullscreen": false,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "minimizable": false,
        "maximizable": false,
        "skipTaskbar": true,
        "center": true
      },
      {
        "label": "update-available",
        "title": "Focus Timer",
        "width": 680,
        "height": 400,
        "resizable": false,
        "fullscreen": false,
        "visible": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "minimizable": false,
        "maximizable": false,
        "skipTaskbar": true,
        "center": true
      },
      {
        "label": "update-progress",
        "title": "Focus Timer",
        "width": 400,
        "height": 148,
        "resizable": false,
        "fullscreen": false,
        "visible": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "minimizable": false,
        "maximizable": false,
        "skipTaskbar": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "26.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../sounds/door-bell.mp3": "sounds/door-bell.mp3",
      "../sounds/hello.mp3": "sounds/hello.mp3",
      "../sounds/reward.mp3": "sounds/reward.mp3",
      "../sounds/microwave.mp3": "sounds/microwave.mp3"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIzOUNENDQ2RjI3OEQ5MTIKUldRUzJYanlSdFNjczM0TXlnazEydWpwRXpQM3lmd0FnbmdkUEdnZ29ESDBTMG0zbFhFV2lUU2QK",
      "endpoints": [
        "https://github.com/rbika/focus-timer/releases/latest/download/latest.json"
      ]
    }
  }
}
